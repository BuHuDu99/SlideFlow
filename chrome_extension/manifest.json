{
  "manifest_version": 3,
  "name": "SlideFlow — Gửi video",
  "version": "1.0.0",
  "description": "Gửi video hoặc playlist YouTube hiện tại vào hàng chờ SlideFlow.",
  "key": "",
  "permissions": [
    "activeTab",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Gửi vào SlideFlow",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}
